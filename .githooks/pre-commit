#!/bin/sh
# Scans the staged changes for secrets before every commit; the organization checks scan the full history on every
# pull request. Enabled per clone: git config --local core.hooksPath .githooks (README.md > Changing this repository).
# A false positive: add a betterleaks:allow comment on the line, or its fingerprint to .betterleaksignore.

if ! command -v betterleaks >/dev/null 2>&1; then
  echo "pre-commit: betterleaks not found; install it (README.md > Changing this repository); to skip the scan for one commit:" >&2
  echo "  git commit --no-verify" >&2
  exit 1
fi

exec betterleaks git --pre-commit --staged --redact --verbose --no-banner .
