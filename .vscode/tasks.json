{
  // Terminal > Run Task... Every task runs the command of the step of the same name in .github/workflows/ci.yml, at the
  // same version; a change there changes the task here too. The tools are listed in README.md > Changing this repository.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "All checks",
      "detail": "Every check below in a row; stops at the first that fails",
      "dependsOn": ["EditorConfig", "Markdown lint", "Markdown links", "Issue forms", "Secret scan"],
      "dependsOrder": "sequence",
      // Ctrl+Shift+B: the only task key VS Code binds by default.
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "EditorConfig",
      "detail": "editorconfig-checker: every tracked file against .editorconfig; prints nothing when clean",
      "type": "process",
      "command": "editorconfig-checker",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Markdown lint",
      "detail": "markdownlint-cli2, the version CI uses",
      "type": "process",
      "command": "npx",
      "args": ["--yes", "markdownlint-cli2@0.23.3"],
      "options": { "cwd": "${workspaceFolder}" },
      "windows": { "command": "npx.cmd" },
      "problemMatcher": []
    },
    {
      "label": "Markdown links",
      "detail": "lychee: links to files of this repository and their #anchors, against the working tree",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-Command",
        "$root = ([uri](Get-Location).Path).AbsoluteUri; lychee --offline --include-fragments --no-progress --remap \"https://github\\.com/devntoltd/\\.github/blob/main/(.*) $root/`$1\" './**/*.md' './.github/**/*.md'"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Issue forms",
      "detail": "check-jsonschema: the issue forms and the chooser config against GitHub's schemas (needs pipx)",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-Command",
        "$forms = Get-ChildItem .github/ISSUE_TEMPLATE/*.yml -Exclude config.yml | ForEach-Object FullName; pipx run check-jsonschema==0.39.0 --builtin-schema vendor.github-issue-forms @forms; if ($LASTEXITCODE) { exit $LASTEXITCODE }; pipx run check-jsonschema==0.39.0 --builtin-schema vendor.github-issue-config .github/ISSUE_TEMPLATE/config.yml; exit $LASTEXITCODE"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Secret scan",
      "detail": "Betterleaks: the full git history, as the organization checks scan it",
      "type": "process",
      "command": "betterleaks",
      "args": ["git", "--redact", "--verbose", "--no-banner", "."],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
